    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start Bot",
            "cwd": "${workspaceFolder}\\bot",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\bot\\index.js"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Deploy Commands",
            "cwd": "${workspaceFolder}\\bot",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\bot\\deploy-commands.js"
        }
    ]
}